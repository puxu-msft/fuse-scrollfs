# zipfs systemd user unit — 长期运行 + 崩溃自重挂（生产化，ROADMAP T1）。
# 安装：cp 到 ~/.config/systemd/user/zipfs.service，改下面 ExecStart 路径，再
#   systemctl --user daemon-reload && systemctl --user enable --now zipfs
# WSL（无 systemd 时）改用 /etc/wsl.conf：
#   [boot]
#   command = /home/USER/src/zipfs/bench/scripts/zipfs-mount.sh /data/back /mnt/zipfs
[Unit]
Description=zipfs transparent-compression FUSE mount (layout S)
After=local-fs.target

[Service]
# Type=notify：zipfs 前台运行，挂载就绪后 sd_notify(READY)，崩溃 WatchdogSec 内无心跳即重启。
Type=notify
ExecStartPre=/bin/mkdir -p %h/.claude-zip/back %h/.claude-zip/mnt
ExecStart=%h/src/zipfs/target/release/zipfs --backend shadow --backing %h/.claude-zip/back --mountpoint %h/.claude-zip/mnt --pid-file %h/.claude-zip/zipfs.pid
ExecStop=/usr/bin/fusermount3 -u %h/.claude-zip/mnt
WatchdogSec=30
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target

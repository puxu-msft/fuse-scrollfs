# rand-read.fio — 随机读吞吐与延迟（4k + 64k 两个 job）。
#
# 目标目录由环境变量 DIR 指定。两个 job 各自独立计时（group_reporting 关闭，
# 见每 job 的命名），便于 collect.py 按 job 名拆分 4k / 64k。
#
# 注意: 随机读需要预先存在的数据文件。本 job 用 fio 自身的 layout 阶段创建
# size=1G 的文件再读；若文件已由前序 seq-write 留下且大小匹配，fio 会复用。
# 冷缓存语义由 run-suite.sh 在调用前 drop_caches 保证（此处不依赖 invalidate）。

[global]
directory=${DIR}
ioengine=psync
direct=0
size=1G
runtime=0
percentile_list=50:99
# 各 job 单独汇报，便于区分块大小。
group_reporting=0

[rand-read-4k]
rw=randread
bs=4k
numjobs=1

[rand-read-64k]
rw=randread
bs=64k
numjobs=1
